# =============================================================================
# oCabra — variables de entorno
# =============================================================================
# Copia este fichero como .env (setup.sh lo hace por ti y rellena los secretos).
#
# Cómo leerlo:
# - Las líneas `CLAVE=valor` sin comentar son las que una instalación nueva
#   fija de verdad. Las `# CLAVE=valor` comentadas muestran el valor por
#   defecto: descoméntalas solo para cambiarlo.
# - Las variables de la api son los campos de backend/ocabra/config.py (en
#   mayúsculas); el valor comentado es el de ese fichero o, si
#   docker-compose.yml pasa otro con `${CLAVE:-valor}`, el de compose, que es
#   el que acaba viendo el contenedor. Otras (puertos del host, uid, rutas del
#   host, Postgres) solo las lee docker-compose.yml o setup.sh.
# - Lo que se guarda desde Ajustes en el panel (tabla server_config) se aplica
#   en cada arranque de la api y pisa lo que diga este fichero.
# - Una clave mal escrita se ignora sin aviso (extra="ignore").
# - Vacío equivale a no definida (env_ignore_empty): se usa el valor por defecto.
# - APP_VERSION no se lee del entorno: la versión es la del código.
#
# backend/tests/test_env_example.py comprueba que toda clave de aquí existe en
# config.py o en compose/setup.sh, que todo ajuste de config.py está aquí y que
# los valores comentados coinciden con los por defecto.

# -----------------------------------------------------------------------------
# Secretos — setup.sh genera los vacíos. No los subas a git ni los pierdas.
# -----------------------------------------------------------------------------
# Firma de las sesiones del panel. Vacío = uno aleatorio en cada arranque (se
# cierran todas las sesiones al reiniciar).
JWT_SECRET=
# Cifra los secretos guardados en la BD (claves de federación, auth y env de
# los MCP). Solo vive aquí, nunca en la BD; al arrancar se recifra lo que
# estuviera con la clave antigua (derivada de JWT_SECRET). Sin ella esos
# secretos no se pueden leer.
OCABRA_SECRETS_KEY=
# Contraseña de Redis. Con ella, docker-compose.yml construye el REDIS_URL de
# la api y de hw-monitor; vacía, Redis queda abierto en la red de compose.
REDIS_PASSWORD=
# Contraseña de Postgres. Vacía = "ocabra" (valor por defecto de compose).
POSTGRES_PASSWORD=
# Token compartido gateway → api para las llamadas internas de los servicios.
GATEWAY_SERVICE_TOKEN=
# Token de Hugging Face (modelos gated/privados).
HF_TOKEN=
# Administrador inicial (setup.sh los pregunta la primera vez). Solo se usan
# para crear el usuario si la BD no tiene ninguno.
# OCABRA_ADMIN_USER=ocabra
# OCABRA_ADMIN_PASS=ocabra

# -----------------------------------------------------------------------------
# Base de datos y Redis
# -----------------------------------------------------------------------------
POSTGRES_USER=ocabra
POSTGRES_DB=ocabra
# setup.sh la escribe a partir de POSTGRES_* (con la contraseña codificada).
# Vacía = postgresql+asyncpg://ocabra:ocabra@postgres:5432/ocabra.
DATABASE_URL=
# La api y hw-monitor reciben REDIS_URL de docker-compose.yml (con
# REDIS_PASSWORD); esta línea solo vale fuera de compose.
# REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Rutas del host y usuario
# -----------------------------------------------------------------------------
# Raíz de modelos en el host: <raíz>/ocabra/models, <raíz>/ocabra/hf_cache y
# <raíz>/ollama. En WSL2 setup.sh la cambia a ~/.local/share/ocabra/ai-models.
AI_MODELS_ROOT=/docker/ai-models
# Checkout de ACE-Step (backend acestep y servicio opcional). En WSL2 setup.sh
# lo mueve a ~/.local/share/ocabra/ACE-Step-1.5.
ACESTEP_ROOT=/docker/ACE-Step-1.5
# uid/gid con los que corre la api (no es root): deben ser los dueños de
# data/ y de AI_MODELS_ROOT. setup.sh pone los del usuario que lo ejecuta.
# Para pasar una instalación antigua: backend/scripts/chown-api-data.sh.
# OCABRA_UID=1000
# OCABRA_GID=1000
# uid/gid del contenedor del frontend.
# FRONTEND_UID=1000
# FRONTEND_GID=1000
# Rutas dentro del contenedor. docker-compose.yml fija MODELS_DIR y
# HF_CACHE_DIR a estos valores (montados desde AI_MODELS_ROOT); cambiarlas
# aquí no tiene efecto con compose.
# MODELS_DIR=/data/models
# HF_CACHE_DIR=/data/hf_cache
# Destino de las descargas. Vacío = {MODELS_DIR}/downloads.
# DOWNLOAD_DIR=
# Ficheros de /v1/files y Batches, e imágenes generadas (response_format=url).
# OPENAI_FILES_DIR=/data/openai_files
# IMAGE_OUTPUTS_DIR=/data/image_outputs

# -----------------------------------------------------------------------------
# Imágenes publicadas y actualización automática
# -----------------------------------------------------------------------------
# Sin definir, el stack construye y usa sus propias imágenes (los valores de
# abajo) y la actualización solo avisa. Para usar las publicadas, ponlas a
# ghcr.io/successbyfailure/ocabra-api:X.Y.Z y
# ghcr.io/successbyfailure/ocabra-frontend:X.Y.Z: el nodo se actualiza según
# SELF_UPDATE_POLICY (el actualizador reescribe estas dos líneas).
# OCABRA_API_IMAGE=ocabra-api:slim
# OCABRA_FRONTEND_IMAGE=ocabra-frontend:latest
# off | notify (avisa, se aplica a petición) | auto (se aplica en reposo).
# SELF_UPDATE_POLICY=notify
# Minutos sin peticiones antes de aplicar una actualización en modo auto.
# SELF_UPDATE_IDLE_MINUTES=10
# SELF_UPDATE_CHECK_INTERVAL_S=3600
# Prefijo de las imágenes ocabra-api / ocabra-frontend publicadas.
# SELF_UPDATE_IMAGE_REPO=ghcr.io/successbyfailure

# -----------------------------------------------------------------------------
# Backends de inferencia (instalación)
# -----------------------------------------------------------------------------
# Cada backend se instala aparte (Ajustes → Backends) en un subdirectorio de
# BACKENDS_DIR (volumen backends_data): descargándolo ya construido del
# registro OCI o compilándolo desde el código fuente.
# BACKENDS_DIR=/data/backends
# Repositorio OCI con un tag por backend. Vacío = solo instalación desde fuente.
# BACKEND_OCI_REPOSITORY=ghcr.io/successbyfailure/ocabra-backends
# Token de lectura si ese repositorio es privado (un token de GitHub con
# read:packages). Vacío = repositorio público; si es privado y falta, la
# instalación en modo auto cae a compilar desde fuente.
BACKEND_OCI_TOKEN=
# true en la imagen "fat" (todo preinstalado): los backends sin metadata.json
# cuentan como integrados. La imagen slim (la de por defecto) ya lo fija a
# false en su Dockerfile.
# BACKENDS_FAT_IMAGE=true

# -----------------------------------------------------------------------------
# Red, acceso público y registro
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# production = logs en JSON (una línea por evento); cualquier otro valor, en
# consola con colores.
# OCABRA_ENV=development
# URL pública de la api (la que ve el cliente), para enlaces absolutos como
# /v1/images/generations con response_format=url. Vacío = se deduce de la
# petición (solo funciona si el proxy reenvía X-Forwarded-* y uvicorn lo cree).
# PUBLIC_URL=
# true si el panel se sirve por HTTPS (cookies de sesión con Secure).
# USE_HTTPS=false
# Dominio de la cookie de sesión para compartir login entre el panel y los
# portales de servicios en subdominios (p. ej. .example.com). Vacío = solo el host.
# AUTH_COOKIE_DOMAIN=
# Puerto adicional del host en el que Caddy sirve el portal de servicios. El
# panel y la api están siempre en el 8484.
# SERVICES_PORTAL_PORT=8485
# Interfaz del host donde se publica el puerto 7869 de Ollama. Ollama no tiene
# autenticación y oCabra no necesita el puerto (usa la red de compose);
# 0.0.0.0 lo abre a toda la red.
# OLLAMA_BIND=127.0.0.1

# -----------------------------------------------------------------------------
# Autenticación y control de acceso
# -----------------------------------------------------------------------------
# Exigir API key en /v1/* (OpenAI) y /api/* (Ollama).
# REQUIRE_API_KEY_OPENAI=true
# REQUIRE_API_KEY_OLLAMA=true
# Grupos que se asignan a los usuarios nuevos (array JSON).
# NEW_USER_GROUP_NAMES=["default","Makers"]
# Duración de la sesión del panel, normal y con "recordarme".
# JWT_TTL_HOURS=24
# JWT_REMEMBER_DAYS=30
# URLs de imagen/vídeo/audio en los chats: las direcciones privadas se
# rechazan salvo que se permitan aquí (hosts o CIDR, separados por comas).
# MEDIA_URL_ALLOW_PRIVATE=false
# MEDIA_URL_ALLOWED_HOSTS=
# Si es true, un model_id canónico (con '/') se resuelve a su perfil por
# defecto con aviso de obsolescencia; false = solo profile_id (404 si no).
# LEGACY_MODEL_ID_FALLBACK=true
# false = no se pueden crear servidores MCP con transporte stdio, ni siquiera
# un administrador.
# MCP_STDIO_ALLOWED=true

# -----------------------------------------------------------------------------
# Privacidad, ficheros y Batches
# -----------------------------------------------------------------------------
# functional (metadatos por petición y ficheros temporales que se limpian) |
# zero_data (no se guarda nada).
# PRIVACY_MODE=functional
# Horas tras terminar su batch (o tras subirse, si ninguno lo usa) antes de
# borrar un fichero de /v1/files. 0 = conservar.
# OPENAI_FILES_RETENTION_HOURS=168
# /v1/videos: horas que se guarda un MP4 tras generarse (en
# OPENAI_FILES_DIR/videos), duración por defecto y tope en segundos, tamaño
# por defecto y tope de píxeles por fotograma (1280x704 cabe en 24 GB).
# VIDEO_RETENTION_HOURS=24
# VIDEO_DEFAULT_SECONDS=5
# VIDEO_MAX_SECONDS=10
# VIDEO_DEFAULT_SIZE=1280x704
# VIDEO_MAX_PIXELS=1048576
# Tope de cada imagen de entrada (input_reference / last_frame), en MB.
# VIDEO_MAX_IMAGE_MB=20
# Peticiones por batch (más → 400 batch_too_large).
# BATCH_MAX_REQUESTS=50000
# Peticiones simultáneas por batch.
# BATCH_MAX_CONCURRENCY=4
# Timeout por línea de batch (se mantiene por encima del de inferencia).
# BATCH_REQUEST_TIMEOUT_SECONDS=960
# BATCH_POLL_INTERVAL_SECONDS=5
# Prioridad de lo interactivo sobre los batches. false = FIFO sin desalojo.
# BATCH_PRIORITY_ENABLED=true
# never | instant | conditional: qué hacer con una petición de batch en curso
# cuando una interactiva necesita su hueco y no hay ninguno libre.
# BATCH_PREEMPT_MODE=conditional
# conditional: solo se deja terminar a lo que ya lleva este tiempo...
# BATCH_PREEMPT_MIN_ELAPSED_S=300.0
# ...y le queda menos que esto según el estimador.
# BATCH_PREEMPT_GRACE_S=10.0
# Fracción de los huecos ocupados por batches que se libera (1.0 = todos).
# BATCH_FREE_SLOTS_PCT=1.0
# Pausa de los batches en un worker tras cancelarles un hueco / tras expulsar
# el modelo por prioridad interactiva.
# BATCH_RESUME_COOLDOWN_SLOTS_S=120.0
# BATCH_RESUME_COOLDOWN_EVICTION_S=300.0
# Pausa entre un batch que termina y el siguiente. 0 = seguidos.
# BATCH_INTER_JOB_COOLDOWN_S=0.0

# Benchmarks de aplicaciones (UI /ocabra/benchmarks). El workspace conserva
# checkouts, resultados parciales y logs para poder pausar y reanudar.
# BENCHMARK_DIR=/data/benchmarks
# BENCHMARK_BASE_URL=http://127.0.0.1:8000
# BENCHMARK_POLL_INTERVAL_S=1.0
# Segundos sin tráfico interactivo antes de reanudar automáticamente.
# BENCHMARK_QUIET_PERIOD_S=30.0
# Token de solo lectura si algún repositorio de datasets es privado.
# BENCHMARK_GIT_TOKEN=
# Corrala resetea por completo esta base. Vacío crea <DATABASE_URL>_bench.
# BENCHMARK_CORRALA_DATABASE_URL=
# Tamaño máximo por parte multipart en /v1/audio/transcriptions y en
# /v1/images/edits (MB).
# OPENAI_AUDIO_MAX_PART_SIZE_MB=256
# OPENAI_IMAGE_MAX_PART_SIZE_MB=25
# Tamaño máximo del segmento de vídeo subido a /ocabra/video/upscale (MB).
# VIDEO_UPSCALE_MAX_UPLOAD_MB=512
# Segundos antes de borrar una imagen generada con response_format=url.
# IMAGE_URL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Descargas
# -----------------------------------------------------------------------------
# Espacio libre mínimo (GB) en MODELS_DIR para empezar una descarga.
# DOWNLOAD_MIN_FREE_GB=30
# Cuánto se guardan los trabajos de descarga terminados / fallidos o
# cancelados, y cada cuánto se limpian.
# DOWNLOAD_JOB_RETENTION_COMPLETED_S=3600
# DOWNLOAD_JOB_RETENTION_FAILED_S=86400
# DOWNLOAD_JOB_CLEANUP_POLL_INTERVAL_S=900

# -----------------------------------------------------------------------------
# GPUs, VRAM y colocación
# -----------------------------------------------------------------------------
# GPU por defecto (índice NVML, en orden PCI).
# DEFAULT_GPU_INDEX=1
# Orden PCI para que los índices CUDA coincidan con los de NVML.
# CUDA_DEVICE_ORDER=PCI_BUS_ID
# Rango de puertos de los workers (todos los backends comparten uno solo).
# WORKER_PORT_RANGE_START=18000
# WORKER_PORT_RANGE_END=19000
# Carpeta persistente de logs de los workers (uno por worker). En el volumen de
# datos para que sobrevivan a recrear el contenedor; si no se puede crear o
# escribir, los backends caen a /tmp con un aviso.
# WORKER_LOG_DIR=/data/logs/workers
# VRAM que se deja siempre libre por GPU (MB).
# VRAM_BUFFER_MB=512
# % de VRAM LIBRE por debajo del cual una GPU queda fuera del primer pase de
# selección. No expulsa nada; con valores altos una GPU pequeña con un PIN
# dentro nunca cuenta como sana y su preferred_gpu se ignora.
# VRAM_PRESSURE_THRESHOLD_PCT=20.0
# Fracción de VRAM usada a partir de la cual el vigilante expulsa modelos LRU.
# Debe quedar por encima del gpu_memory_utilization más alto que uses.
# VRAM_EVICTION_THRESHOLD=0.96
# Devolver un modelo a su GPU preferida cuando esta queda libre (solo si está
# ocioso, no hay otra carga y cabe sin expulsar nada), con residencia mínima y
# enfriamiento para que no rebote.
# PREFERRED_GPU_REPLACEMENT_ENABLED=true
# PREFERRED_GPU_REPLACEMENT_MIN_RESIDENCY_S=180
# PREFERRED_GPU_REPLACEMENT_COOLDOWN_S=900
# Espera máxima a que terminen las peticiones antes de expulsar por presión,
# y tope absoluto de cualquier espera de drenaje.
# PRESSURE_EVICTION_DRAIN_TIMEOUT_S=60
# Si otro modelo espera la GPU, el cargado aguarda esto tras su última
# petición por si llega la siguiente (los agentes encadenan); 0 = sin gracia.
# EVICTION_FOLLOWUP_GRACE_S=4.0
# Tope de esa gracia desde que empieza el desalojo.
# EVICTION_FOLLOWUP_MAX_CHAIN_S=60.0
# MAX_DRAIN_TIMEOUT_S=600
# Intervalo esperado entre muestras de gpu_stats de hw-monitor (para no contar
# huecos normales como caídas). Un poco por encima del real (60 s).
# GPU_STATS_EXPECTED_INTERVAL_S=90

# Retención de estadísticas (stats/retention.py). Las tablas de stats solo
# crecían (nunca se borraba nada). La poda periódica viene DESACTIVADA a
# propósito: activarla en el primer arranque borraría meses de histórico sin
# que nadie haya visto el ajuste. Actívala desde Ajustes cuando los horizontes
# de abajo te cuadren. Edad máxima por tabla en días (0 = conservar siempre);
# request_stats se guarda mucho más que las muestras de alta frecuencia de
# gpu/server. La poda es por lotes, asíncrona y no bloqueante.
# STATS_RETENTION_ENABLED=false
# STATS_RETENTION_REQUEST_STATS_DAYS=365
# STATS_RETENTION_GPU_STATS_DAYS=90
# STATS_RETENTION_SERVER_STATS_DAYS=90
# STATS_RETENTION_INTERVAL_S=86400
# STATS_RETENTION_BATCH_SIZE=10000

# -----------------------------------------------------------------------------
# Ciclo de vida de los modelos, admisión y workers
# -----------------------------------------------------------------------------
# Inactividad antes de descargar un modelo on_demand, y cada cuánto se mira.
# IDLE_TIMEOUT_SECONDS=300
# IDLE_EVICTION_CHECK_INTERVAL_SECONDS=15
# Espera máxima de una petición a que su modelo termine de cargar.
# MODEL_LOAD_WAIT_TIMEOUT_S=720
# Autocarga de los modelos PIN: retraso tras arrancar, espera adicional a las
# cargas en curso, y sondeo para recargarlos tras una expulsión.
# PIN_AUTOLOAD_DELAY_S=60
# PIN_AUTOLOAD_MAX_WAIT_S=300
# PIN_RELOAD_POLL_INTERVAL_S=120
# Tiempo máximo de inferencia antes de cancelar y responder 504.
# INFERENCE_REQUEST_TIMEOUT_SECONDS=1500
# Vigilante de peticiones ocupadas (nunca por debajo del timeout de
# inferencia) y qué hacer: mark_error | restart_worker.
# BUSY_TIMEOUT_SECONDS=300
# BUSY_TIMEOUT_ACTION=mark_error
# Peticiones simultáneas por modelo (0 = sin límite) y en cola por hueco real
# del worker: el tope efectivo es min(MAX_INFLIGHT_PER_MODEL, huecos × esto).
# MAX_INFLIGHT_PER_MODEL=32
# MAX_QUEUED_PER_SLOT=4
# Huecos declarados de Piper (no tiene escalera de presets).
# PIPER_PARALLELISM=4
# Salud y reinicio automático de workers.
# WORKER_HEALTH_CHECK_INTERVAL_SECONDS=10
# AUTO_RESTART_WORKERS=true
# MAX_WORKER_RESTARTS=3
# WORKER_RESTART_BACKOFF_SECONDS=5.0
# Cortocircuito ante un worker muerto que oCabra no puede detectar (Ollama):
# tras N fallos seguidos responde 503 sin reintentar durante el enfriamiento.
# WORKER_CIRCUIT_BREAKER_THRESHOLD=3
# WORKER_CIRCUIT_BREAKER_COOLDOWN_S=30
# Tope del POST /tokenize con el que se cuenta un prompt antes de rechazarlo.
# TOKENIZE_TIMEOUT_S=5.0
# Tokens de salida que se suponen al elegir preset si el cliente no fija
# max_tokens (solo planificación, no limita la generación).
# RUNTIME_PRESET_DEFAULT_OUTPUT_RESERVATION_TOKENS=4096

# -----------------------------------------------------------------------------
# Razonamiento y salida
# -----------------------------------------------------------------------------
# reasoning_effort que se aplica si el cliente no lo manda: low | medium |
# high | off. extra_config.default_reasoning_effort del modelo lo pisa.
# DEFAULT_REASONING_EFFORT=medium
# Tope duro de tokens de pensamiento (llama.cpp) por nivel pedido; DEFAULT es
# el de una petición sin nivel. 0 = sin tope.
# REASONING_BUDGET_LOW_TOKENS=1000
# REASONING_BUDGET_MEDIUM_TOKENS=4096
# REASONING_BUDGET_HIGH_TOKENS=0
# REASONING_BUDGET_DEFAULT_TOKENS=16384
# Traducción del nivel al vocabulario de las plantillas (JSON). Las de Qwen 3.5
# solo aceptan xhigh/medium/low.
# REASONING_EFFORT_TEMPLATE_ALIASES={"high":"xhigh"}
# Tope de salida inyectado cuando el perfil no declara max_output_tokens.
# 0 = sin tope.
# DEFAULT_MAX_OUTPUT_TOKENS=65536

# -----------------------------------------------------------------------------
# Routers, estimador de duración, Realtime
# -----------------------------------------------------------------------------
# false = los perfiles router se comportan como si no tuvieran destinos.
# ROUTING_ENABLED=true
# Confianza mínima del estimador para que el router se fíe de él.
# ROUTER_CONFIDENCE_FLOOR=0.3
# Estimador: recalibración desde request_stats, caché por estimación y tope.
# ESTIMATOR_REFRESH_INTERVAL_S=1800
# ESTIMATOR_CACHE_TTL_S=30
# ESTIMATOR_MAX_ESTIMATE_S=7200
# Sesiones Realtime: silencio para considerarla en pausa, para darla por
# abandonada, y TTL del latido en Redis.
# SESSION_PAUSE_THRESHOLD_S=120
# SESSION_MAX_IDLE_S=900
# SESSION_HEARTBEAT_TTL_S=300
# Modelos STT/TTS por defecto de /v1/realtime y tope de razonamiento por
# sesión (0 = sin tope por defecto).
# REALTIME_DEFAULT_STT_MODEL=
# REALTIME_DEFAULT_TTS_MODEL=
# REALTIME_DEFAULT_REASONING_BUDGET=300

# -----------------------------------------------------------------------------
# Ollama (un único daemon para todos sus modelos)
# -----------------------------------------------------------------------------
# false en hosts sin daemon Ollama (imagen ocabra-node).
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://ollama:11434
# Valores iniciales; se cambian en Ajustes → Ollama, que reescribe
# data/ollama/ollama.env y recrea el servicio.
# OLLAMA_NUM_PARALLEL=2
# OLLAMA_MAX_CONTEXT=65536
# keep_alive al cargar (30m, 1h, 0 para descargar al terminar).
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_INVENTORY_SYNC_INTERVAL_SECONDS=15
# Gracia para que un modelo recién cargado aparezca en /api/ps.
# OLLAMA_INVENTORY_LOADED_GRACE_S=60
# Recargar un modelo WARM/PIN que se ha derramado a CPU cuando vuelve a caber
# entero en GPU (margen y enfriamiento por modelo).
# OLLAMA_RELOAD_SPILLED=true
# OLLAMA_RELOAD_SPILLED_MARGIN_MB=512
# OLLAMA_RELOAD_SPILLED_COOLDOWN_SECONDS=300
# Expone como modelos llama.cpp los GGUF que Ollama ya tiene bajados. Debe
# coincidir con el montaje de solo lectura de compose; vacío = desactivado.
OLLAMA_SHARED_MODELS_DIR=/data/ollama_models

# -----------------------------------------------------------------------------
# llama.cpp (llama_cpp / llamacpp_mks)
# -----------------------------------------------------------------------------
# Valores por defecto de los workers; cada modelo los pisa en su extra_config
# y en sus presets.
# LLAMA_CPP_SERVER_BIN=/usr/local/bin/llama-server
# LLAMA_CPP_GPU_LAYERS=0
# LLAMA_CPP_CTX_SIZE=4096
# LLAMA_CPP_THREADS=
# LLAMA_CPP_BATCH_SIZE=512
# LLAMA_CPP_UBATCH_SIZE=128
# LLAMA_CPP_FLASH_ATTN=false
# mlock fija en RAM una copia de pesos que ya están en la GPU; el contenedor
# no lo permite (RLIMIT_MEMLOCK=8 MB). Solo tiene sentido en CPU.
# LLAMA_CPP_MLOCK=false
# LLAMA_CPP_EMBEDDINGS=false
# LLAMA_CPP_STARTUP_TIMEOUT_S=60
# LLAMA_CPP_CONT_BATCHING=true
# Huecos por worker (1 = contexto entero para una petición).
# LLAMA_CPP_PARALLEL_SLOTS=1
# Reducir la concurrencia efectiva durante prefills grandes: con prompts de
# más de MEDIUM/LARGE tokens, como mucho N peticiones activas.
# LLAMA_CPP_ADAPTIVE_ADMISSION_ENABLED=true
# LLAMA_CPP_MEDIUM_PREFILL_TOKENS=32768
# LLAMA_CPP_MEDIUM_PREFILL_MAX_CONCURRENCY=3
# LLAMA_CPP_LARGE_PREFILL_TOKENS=65536
# LLAMA_CPP_LARGE_PREFILL_MAX_CONCURRENCY=2
# Usar la VRAM medida de un worker para ajustar la próxima admisión.
# LLAMA_CPP_OBSERVED_VRAM_APPLY=true
# Contexto en vivo (solo el fork): cambiar el contexto sin recargar, encoger
# antes de expulsar y volver a crecer en reposo.
# LLAMA_CPP_LIVE_CONTEXT_ENABLED=false
# LLAMA_CPP_LIVE_CONTEXT_DRAIN_TIMEOUT_S=30.0
# LLAMA_CPP_SHRINK_BEFORE_EVICT=true
# LLAMA_CPP_SHRINK_MIN_CONTEXT=32768
# LLAMA_CPP_REGROW_WHEN_IDLE=true
# MB que los presets de dos GPU dejan libres por GPU al arrancar (JSON
# {"índice": MB}), y cuándo vuelven a ese contexto inicial tras crecer.
# LLAMA_CPP_MULTI_GPU_RESERVE_MB={"0":3300}
# LLAMA_CPP_RETURN_TO_INITIAL_SECONDS=120

# -----------------------------------------------------------------------------
# vLLM
# -----------------------------------------------------------------------------
# docker-compose.yml pasa 0.85 y true si no se fijan (en config.py: 0.9 y false).
# VLLM_GPU_MEMORY_UTILIZATION=0.9
# VLLM_ENFORCE_EAGER=true
# VLLM_USE_FLASHINFER_SAMPLER=false
# VLLM_CACHE_ROOT=/data/backends/vllm/cache
# Vacíos = lo que decida vLLM.
# VLLM_ATTENTION_BACKEND=
# VLLM_ENABLE_PREFIX_CACHING=true
# VLLM_MAX_NUM_SEQS=16
# VLLM_MAX_NUM_BATCHED_TOKENS=8192
# VLLM_TENSOR_PARALLEL_SIZE=
# VLLM_PIPELINE_PARALLEL_SIZE=
# VLLM_MAX_MODEL_LEN=
# VLLM_MODEL_IMPL=
# VLLM_RUNNER=
# VLLM_HF_OVERRIDES=
# VLLM_CHAT_TEMPLATE=
# VLLM_CHAT_TEMPLATE_CONTENT_FORMAT=
# VLLM_GENERATION_CONFIG=
# VLLM_OVERRIDE_GENERATION_CONFIG=
# VLLM_TOOL_CALL_PARSER=
# VLLM_TOOL_PARSER_PLUGIN=
# VLLM_REASONING_PARSER=
# VLLM_LANGUAGE_MODEL_ONLY=
# VLLM_ENABLE_CHUNKED_PREFILL=
# VLLM_KV_CACHE_DTYPE=
# Imágenes por prompt en modelos multimodales (vLLM rechaza imágenes sin esto).
# VLLM_LIMIT_MM_PER_PROMPT_IMAGE=4
# VLLM_TRUST_REMOTE_CODE=false
# VLLM_DISABLE_LOG_REQUESTS=true

# -----------------------------------------------------------------------------
# SGLang
# -----------------------------------------------------------------------------
# SGLANG_PYTHON_BIN=/opt/sglang-venv/bin/python
# SGLANG_SERVER_MODULE=sglang.launch_server
# SGLANG_TENSOR_PARALLEL_SIZE=
# SGLANG_CONTEXT_LENGTH=
# SGLANG_MEM_FRACTION_STATIC=0.9
# SGLANG_TRUST_REMOTE_CODE=false
# SGLANG_DISABLE_RADIX_CACHE=false
# SGLANG_STARTUP_TIMEOUT_S=120

# -----------------------------------------------------------------------------
# TensorRT-LLM (opcional)
# -----------------------------------------------------------------------------
# TENSORRT_LLM_ENABLED=false
# binary (trtllm-serve local) | module (python -m) | docker (contenedor NVIDIA).
# TENSORRT_LLM_LAUNCH_MODE=binary
# TENSORRT_LLM_PYTHON_BIN=/usr/bin/python3
# TENSORRT_LLM_SERVE_BIN=/usr/local/bin/trtllm-serve
# TENSORRT_LLM_SERVE_MODULE=tensorrt_llm.commands.serve
# TENSORRT_LLM_DOCKER_BIN=/usr/bin/docker
# TENSORRT_LLM_DOCKER_IMAGE=nvcr.io/nvidia/tensorrt-llm/release:latest
# Imagen auxiliar para limpiar procesos TRT-LLM huérfanos en el host.
# TENSORRT_LLM_HOST_HELPER_IMAGE=ocabra-api:slim
# Montajes host → contenedor de modelos y caché HF en modo docker.
# TENSORRT_LLM_DOCKER_MODELS_MOUNT_HOST=/docker/ai-models/ocabra/models
# TENSORRT_LLM_DOCKER_MODELS_MOUNT_CONTAINER=/data/models
# TENSORRT_LLM_DOCKER_HF_CACHE_MOUNT_HOST=/docker/ai-models/ocabra/hf_cache
# TENSORRT_LLM_DOCKER_HF_CACHE_MOUNT_CONTAINER=/data/hf_cache
# TENSORRT_LLM_ENGINES_DIR=
# trt | pytorch.
# TENSORRT_LLM_BACKEND=trt
# TENSORRT_LLM_TOKENIZER_PATH=
# TENSORRT_LLM_MAX_BATCH_SIZE=
# TENSORRT_LLM_CONTEXT_LENGTH=
# TENSORRT_LLM_TRUST_REMOTE_CODE=false
# TENSORRT_LLM_STARTUP_TIMEOUT_S=120

# -----------------------------------------------------------------------------
# BitNet / Bonsai (bitnet.cpp y fork PrismML)
# -----------------------------------------------------------------------------
# BITNET_SERVER_BIN=/usr/local/bin/bitnet-server
# BITNET_PRISMML_SERVER_BIN=/usr/local/bin/bonsai-server
# BITNET_GPU_LAYERS=0
# BITNET_CTX_SIZE=4096
# BITNET_THREADS=
# BITNET_BATCH_SIZE=512
# BITNET_UBATCH_SIZE=128
# BITNET_PARALLEL=1
# BITNET_FLASH_ATTN=false
# BITNET_MLOCK=true
# KV cuantizada (q8_0, q4_0); vacío = f16.
# BITNET_CACHE_TYPE_K=
# BITNET_CACHE_TYPE_V=
# BITNET_STARTUP_TIMEOUT_S=30
# Compilación desde fuente (backend/scripts/install_bitnet.sh y la imagen fat).
# BITNET_COMMIT=main
# BITNET_PRETUNED_MODEL=bitnet_b1_58-3B
# BITNET_KERNEL_FLAVOR=tl2
# BITNET_BUILD_JOBS=8
# El fork PrismML (bonsai-server) necesita true para compilarse con CUDA; en
# false (lo que hacen los scripts si no se fija) sale un binario solo CPU.
BITNET_ENABLE_CUDA=true
# Arquitectura CUDA (86 = Ampere). Sin ella cmake usa "native" y falla dentro
# de un contenedor que no ve la GPU.
# BITNET_CUDA_ARCHS=86
# Compilar también el fork PrismML (bonsai-server). Los scripts lo hacen por
# defecto (true); esta plantilla lo desactiva.
BITNET_BUILD_PRISMML=false

# -----------------------------------------------------------------------------
# Voz: Whisper, whisper.cpp, VibeASR, Piper, Chatterbox, Voxtral
# -----------------------------------------------------------------------------
# WHISPER_STARTUP_TIMEOUT_S=300
# Liberar el diarizador tras este tiempo sin peticiones diarizadas (0 = nunca)
# y lo que crece whisper sobre su estimación (diarizar, cada petición extra).
# WHISPER_DIARIZER_IDLE_UNLOAD_S=300.0
# WHISPER_DIARIZATION_EXTRA_MB=3400
# WHISPER_EXTRA_PER_REQUEST_MB=350
# WHISPERCPP_SERVER_BIN=/usr/local/bin/whisper-server
# WHISPERCPP_THREADS=8
# WHISPERCPP_STARTUP_TIMEOUT_S=120
# WHISPERCPP_DIARIZATION_STARTUP_TIMEOUT_S=180
# VIBEASR_PYTHON_BIN=/opt/vibeasr-venv/bin/python
# VIBEASR_STREAM_SERVER_BIN=/usr/local/bin/asr_stream_server
# VIBEASR_THREADS=8
# VIBEASR_STARTUP_TIMEOUT_S=300
# PIPER_PYTHON_BIN=/opt/piper-venv/bin/python
# CHATTERBOX_PYTHON_BIN=/opt/chatterbox-venv/bin/python
# VOXTRAL_PYTHON_BIN=/opt/voxtral-venv/bin/python
# VOXTRAL_STARTUP_TIMEOUT_S=300

# -----------------------------------------------------------------------------
# Diffusers (imagen)
# -----------------------------------------------------------------------------
# auto | float16 | bfloat16 | float32. auto resuelve a fp16, que deja en NaN el
# codificador T5 de FLUX.2/SD3.5.
# DIFFUSERS_TORCH_DTYPE=bfloat16
# DIFFUSERS_ENABLE_TORCH_COMPILE=false
# DIFFUSERS_ENABLE_XFORMERS=false
# none | model | sequential. sequential mantiene el pico en ~2-3 GB (más
# lento); none es el más rápido pero el modelo entero tiene que caber.
# DIFFUSERS_OFFLOAD_MODE=sequential
# DIFFUSERS_ALLOW_TF32=true

# -----------------------------------------------------------------------------
# Energía, temperatura y coste
# -----------------------------------------------------------------------------
# €/kWh para estimar el coste eléctrico.
# ENERGY_COST_EUR_KWH=0.15
# Potencia máxima de la CPU (W) para la barra de consumo. Vacío = límite RAPL
# o TDP conocido.
# CPU_POWER_MAX_W=
# Tope térmico de hw-monitor (WSL2 no permite cambiar límites de potencia por
# NVML: setup.sh lo pone a false allí).
THERMAL_CAP_ENABLED=true
# Recorte de potencia al llegar a MAX_TEMPERATURE_C, durante al menos el
# enfriamiento y hasta bajar el margen. En config.py está desactivado; esta
# plantilla lo activa (setup.sh lo desactiva en WSL2).
GPU_THROTTLE_ENABLED=true
# MAX_TEMPERATURE_C=88
# GPU_THROTTLE_POWER_REDUCTION_PCT=20
# GPU_THROTTLE_COOLDOWN_S=300
# GPU_THROTTLE_RECOVERY_MARGIN_C=5
# Precios de referencia de OpenAI (USD por millón de tokens o equivalente)
# para la estimación de ahorro de las estadísticas.
# OPENAI_REF_SMALL_INPUT=0.15
# OPENAI_REF_SMALL_OUTPUT=0.6
# OPENAI_REF_MEDIUM_INPUT=2.5
# OPENAI_REF_MEDIUM_OUTPUT=10.0
# OPENAI_REF_LARGE_INPUT=10.0
# OPENAI_REF_LARGE_OUTPUT=30.0
# OPENAI_REF_EMBEDDING_INPUT=0.1
# OPENAI_REF_AUDIO_STT_INPUT=6.0
# OPENAI_REF_TTS_INPUT=15.0
# OPENAI_REF_IMAGE_INPUT=40.0

# -----------------------------------------------------------------------------
# Federación y nodos en la nube
# -----------------------------------------------------------------------------
# Se configura desde la página Federación; esto son los valores de arranque.
# FEDERATION_ENABLED=false
# FEDERATION_NODE_NAME=
# Vacío = se genera y se guarda la primera vez.
# FEDERATION_NODE_ID=
# Aceptar solicitudes de unión sin invitación (siguen necesitando aprobación).
# FEDERATION_ACCEPT_JOIN_REQUESTS=false
# FEDERATION_HEARTBEAT_INTERVAL=30
# FEDERATION_PROXY_TIMEOUT_S=300
# FEDERATION_VERIFY_SSL=true
# FEDERATION_JOIN_POLL_INTERVAL_S=10
# Nodo desatendido (p. ej. un pod): unirse a este hub al arrancar con esta
# invitación. Implica FEDERATION_ENABLED=true; abre un túnel saliente, así que
# el nodo no necesita URL pública.
# FEDERATION_JOIN_URL=
# FEDERATION_JOIN_INVITE=
# La api de este nodo vista desde sí mismo (atiende lo que llega por el túnel).
# FEDERATION_LOCAL_URL=http://127.0.0.1:8000
# Pod en la nube (lo fija el hub al lanzarlo): apagarse si lleva estos minutos
# sin túnel con el hub. 0 = nunca.
# OCABRA_CLOUD_SELF_DESTRUCT_MINUTES=0

# -----------------------------------------------------------------------------
# Agentes y MCP
# -----------------------------------------------------------------------------
# MCP_TOOLS_CACHE_TTL_SECONDS=300
# MCP_DEFAULT_TOOL_TIMEOUT_SECONDS=60
# MCP_MAX_CONCURRENT_TOOL_CALLS=8
# MCP_RESULT_MAX_BYTES=262144
# AGENT_SUBAGENT_TIMEOUT_SECONDS=600
# AGENT_SUBAGENT_RESULT_MAX_BYTES=32768

# -----------------------------------------------------------------------------
# Servicios interactivos opcionales (perfil "services" de compose:
# bash setup.sh --with-services)
# -----------------------------------------------------------------------------
# URL interna (health checks y descarga), URL pública que abre el navegador,
# GPU preferida, inactividad antes de liberar VRAM, espera a una generación en
# curso antes de expulsarlo (0 = inmediato, -1 = indefinido) y nombre del
# contenedor.
#
# TRELLIS.2 (3D)
# TRELLIS2_BASE_URL=http://trellis2:8080
# TRELLIS2_UI_URL=
# TRELLIS2_PREFERRED_GPU=1
# TRELLIS2_IDLE_UNLOAD_SECONDS=300
# TRELLIS2_GENERATION_GRACE_PERIOD_S=120
# TRELLIS2_DOCKER_CONTAINER=ocabra-trellis2-1
# Puerto del host, prefijo ASGI si se sirve bajo un subpath (nunca una URL
# completa) y GPU física visible (no "all": el orden CUDA del contenedor no
# coincide con el NVML de oCabra).
# TRELLIS2_PORT=8481
# TRELLIS2_ROOT_PATH=
# TRELLIS2_NVIDIA_VISIBLE_DEVICES=1
#
# ComfyUI
# COMFYUI_BASE_URL=http://comfyui:8188
# COMFYUI_UI_URL=
# COMFYUI_PREFERRED_GPU=1
# COMFYUI_IDLE_UNLOAD_SECONDS=600
# COMFYUI_GENERATION_GRACE_PERIOD_S=120
# COMFYUI_DOCKER_CONTAINER=ocabra-comfyui-1
# COMFYUI_PORT=8188
#
# Automatic1111
# A1111_BASE_URL=http://a1111:7860
# A1111_UI_URL=
# A1111_PREFERRED_GPU=1
# A1111_IDLE_UNLOAD_SECONDS=600
# A1111_GENERATION_GRACE_PERIOD_S=120
# A1111_DOCKER_CONTAINER=ocabra-a1111-1
# A1111_PORT=7860
#
# ACE-Step (música). Modo gradio (UI en 7860) o api (REST en 8001; entonces
# la URL interna pasa a ser http://acestep:8001).
# ACESTEP_BASE_URL=http://acestep:7860
# ACESTEP_UI_URL=
# ACESTEP_PREFERRED_GPU=1
# ACESTEP_IDLE_UNLOAD_SECONDS=1800
# ACESTEP_GENERATION_GRACE_PERIOD_S=180
# ACESTEP_DOCKER_CONTAINER=ocabra-acestep-1
# ACESTEP_MODE=gradio
# ACESTEP_GRADIO_PORT=7862
# ACESTEP_NVIDIA_VISIBLE_DEVICES=1
# ACESTEP_LLM_BACKEND=pt
# ACESTEP_INIT_SERVICE=true
# ACESTEP_CONFIG_PATH=acestep-v15-turbo
# ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-0.6B
# Backend acestep (subproceso dentro de la api): checkout, tiempos, y una API
# REST externa a la que delegar en vez de lanzar el subproceso.
# ACESTEP_PROJECT_DIR=/docker/ACE-Step-1.5
# ACESTEP_STARTUP_TIMEOUT_S=300
# ACESTEP_GENERATION_TIMEOUT_S=600
# ACESTEP_POLL_INTERVAL_S=1.0
# ACESTEP_EXTERNAL_API_URL=
# % de uso de GPU que se toma como "generando" en servicios sin endpoint de
# estado (ACE-Step).
# GENERATION_GPU_UTIL_THRESHOLD_PCT=50
#
# Unsloth Studio (entrenamiento, chat y exportación a GGUF). Por defecto no se
# libera nunca por inactividad y se espera indefinidamente a que termine.
# UNSLOTH_BASE_URL=http://unsloth-studio:8000
# UNSLOTH_UI_URL=
# UNSLOTH_PREFERRED_GPU=1
# UNSLOTH_IDLE_UNLOAD_SECONDS=0
# UNSLOTH_GENERATION_GRACE_PERIOD_S=-1
# UNSLOTH_DOCKER_CONTAINER=ocabra-unsloth-studio-1
# UNSLOTH_IMAGE=unsloth/unsloth:latest
# UNSLOTH_STUDIO_PORT=8889
# UNSLOTH_NVIDIA_VISIBLE_DEVICES=1
# Contraseña de Jupyter. Vacía = "ocabra": cámbiala si publicas el puerto.
UNSLOTH_JUPYTER_PASSWORD=
#
# Gateway de servicios: puerto del host, URL pública del directorio de
# servicios y tiempos de arranque / aviso de actividad.
# GATEWAY_PORT=9000
# DIRECTORY_UI_URL=
# GATEWAY_STARTUP_TIMEOUT_S=180
# GATEWAY_TOUCH_INTERVAL_S=30

# -----------------------------------------------------------------------------
# Interno — los fija docker-compose.yml o la imagen; no hace falta tocarlos
# -----------------------------------------------------------------------------
# Agente de Docker: el único contenedor con el socket. Compose ya pasa la URL
# a la api; vacía = sin agente (la api necesitaría el socket).
# DOCKER_AGENT_URL=http://docker-agent:8790
# DOCKER_AGENT_PORT=8790
# DOCKER_AGENT_TOKEN_FILE=/run/ocabra-agent/token
# Directorio del proyecto compose y fichero de entorno del daemon Ollama, tal
# como los ve el contenedor.
# COMPOSE_PROJECT_DIR=/opt/ocabra
# OLLAMA_ENV_FILE=/opt/ocabra/data/ollama/ollama.env
# Traza por muestra de VRAM durante las cargas (diagnóstico).
# DEBUG_LOG_LOAD_VRAM_SAMPLES=true
