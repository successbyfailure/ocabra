{
    admin off
}

:80 {
    # API routes → backend
    handle /v1/* {
        reverse_proxy api:8000
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /ocabra/* {
        reverse_proxy api:8000
    }
    handle /health {
        reverse_proxy api:8000
    }
    handle /ready {
        reverse_proxy api:8000
    }
    # Sin esta regla /version se caia al SPA del frontend, que responde con su
    # propio 404 de nginx: el mismo patron que las subrutas de /docs.
    handle /version {
        reverse_proxy api:8000
    }
    # /docs y todo lo que cuelga: ademas del Swagger estan las paginas en prosa
    # (/docs/changelog, /docs/models, y sus variantes .md) y el
    # /docs/oauth2-redirect de Swagger. Con "handle /docs" a secas solo casaba
    # la ruta exacta y las subrutas se caian al SPA del frontend, que devolvia
    # 404.
    handle /docs {
        reverse_proxy api:8000
    }
    handle /docs/* {
        reverse_proxy api:8000
    }
    handle /redoc {
        reverse_proxy api:8000
    }
    handle /openapi.json {
        reverse_proxy api:8000
    }
    handle /metrics {
        reverse_proxy api:8000
    }

    # Frontend (React SPA) — everything else
    handle {
        reverse_proxy frontend:8080
    }
}
